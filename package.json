{
  "name": "mon-coach-echecs",
  "version": "1.0.0",
  "description": "Application Desktop d'Entraînement aux Échecs Assistée par IA Locale",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup:engines": "node scripts/setup-engines.mjs",
    "package:win": "tsc && vite build && electron-builder --win zip",
    "package:win:installer": "tsc && vite build && electron-builder --win nsis",
    "package:win:zip": "tsc && vite build && electron-builder --win zip",
    "package:win:dir": "tsc && vite build && electron-builder --win --dir",
    "package:linux": "tsc && vite build && electron-builder --linux",
    "package:linux:dir": "tsc && vite build && electron-builder --linux --dir",
    "package:mac": "tsc && vite build && electron-builder --mac",
    "package:mac:dir": "tsc && vite build && electron-builder --mac --dir"
  },
  "keywords": [
    "chess",
    "maia",
    "stockfish",
    "deepseek",
    "ollama",
    "electron",
    "chessground"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.5"
  },
  "type": "module"
}
