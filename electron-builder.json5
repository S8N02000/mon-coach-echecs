{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.moncoachechecs.app",
  "productName": "Mon Coach Échecs",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "dist-electron/**"
  ],
  "icon": "build/icon.png",
  "extraResources": [
    {
      "from": "resources/bin",
      "to": "bin",
      "filter": ["!python_win/**", "!maia3-uci.cmd"]
    },
    {
      "from": "resources",
      "to": "resources",
      "filter": ["icon.png", "icon.ico", "logo-full.png"]
    },
    {
      "from": "resources/models",
      "to": "models",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "signAndEditExecutable": false,
    "extraResources": [
      {
        "from": "resources/bin/python_win",
        "to": "bin/python_win",
        "filter": ["**/*"]
      },
      {
        "from": "resources/bin/maia3-uci.cmd",
        "to": "bin/maia3-uci.cmd"
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "artifactName": "MonCoachEchecs-Portable.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Mon Coach Échecs",
    "artifactName": "Setup-MonCoachEchecs.exe"
  },
  "linux": {
    "icon": "build/icons",
    "target": ["AppImage"],
    "category": "Game"
  },
  "mac": {
    "icon": "build/icon.png",
    "target": ["dmg", "zip"],
    "category": "public.app-category.board-games"
  }
}
